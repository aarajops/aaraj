{
  "name": "@aaraj/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:grant-runtime": "node dist/platform/database/grant-runtime-privileges.js",
    "access:bootstrap": "node dist/platform/authorization/bootstrap-superadmin.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm --filter @aaraj/contracts run build && pnpm run build && vitest run --config ./vitest.config.e2e.ts",
    "test:r2:live": "vitest run --config ./vitest.config.r2.ts",
    "e2e:server": "node test/e2e-server.mjs"
  },
  "dependencies": {
    "@aaraj/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@better-auth/redis-storage": "1.7.6",
    "@nestjs/authorization": "0.0.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.1.1",
    "ioredis": "5.8.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
