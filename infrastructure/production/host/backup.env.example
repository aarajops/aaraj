# Install as /etc/sites/aaraj/backup.env, root:root mode 0600.
# Set the age limits from the approved AARAJ recovery objectives.
RESTIC_REPOSITORY=__OFFSITE_RESTIC_REPOSITORY__
RESTIC_PASSWORD_FILE=__ABSOLUTE_PATH_TO_ROOT_ONLY_RESTIC_PASSWORD_FILE__
RESTIC_BIN=__ABSOLUTE_PATH_TO_INSTALLED_RESTIC__
AARAJ_RESTIC_DATABASE_TAG=__DATABASE_SNAPSHOT_TAG__
AARAJ_RESTORE_DRILL_SNAPSHOT_ID=__64_CHARACTER_RESTIC_SNAPSHOT_ID__
# Format: YYYY-MM-DDTHH:MM:SSZ (UTC, whole-second precision).
AARAJ_RESTORE_DRILL_COMPLETED_AT=__UTC_TIMESTAMP_AFTER_SUCCESSFUL_RESTORE__
AARAJ_BACKUP_MAX_AGE_HOURS=__APPROVED_MAX_BACKUP_AGE_HOURS__
AARAJ_RESTORE_DRILL_MAX_AGE_DAYS=__APPROVED_MAX_RESTORE_DRILL_AGE_DAYS__

# Add the selected object-storage provider's credentials here, root-only.
