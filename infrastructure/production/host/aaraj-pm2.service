[Unit]
Description=AARAJ application processes supervised by PM2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aaraj
Group=aaraj
SupplementaryGroups=aaraj-code
Environment=NODE_ENV=production
Environment=PM2_HOME=/var/lib/sites/aaraj/pm2
WorkingDirectory=/srv/sites/aaraj/releases/current
StateDirectory=sites/aaraj/pm2
LogsDirectory=sites/aaraj
UMask=0027
ExecStart=/usr/local/bin/pm2-runtime start /etc/sites/aaraj/ecosystem.config.cjs --env production
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/sites/aaraj/shared /var/lib/sites/aaraj/pm2 /var/log/sites/aaraj
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
