# Copy to /etc/sites/aaraj/migration.env; owner root:aaraj-migrate, mode 0640.
# This file contains no runtime password. Keep the migration and runtime roles distinct.
POSTGRES_HOST=__CERTIFICATE_VERIFIED_POSTGRES_HOSTNAME__
POSTGRES_PORT=5432
POSTGRES_DB=aaraj_production
POSTGRES_USER=aaraj_runtime
MIGRATION_POSTGRES_USER=aaraj_migrator
MIGRATION_POSTGRES_PASSWORD=__AARAJ_RESTRICTED_MIGRATION_ROLE_PASSWORD__
POSTGRES_SSL_CA_FILE=/etc/sites/aaraj/postgres-ca.pem
