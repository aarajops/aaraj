[Unit]
Description=Approved AARAJ Drizzle migration for release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aaraj-migrate
Group=aaraj-migrate
SupplementaryGroups=aaraj-code
Environment=NODE_ENV=production
Environment=RELEASE_COMMIT_SHA=%i
EnvironmentFile=/etc/sites/aaraj/migration.env
WorkingDirectory=/srv/sites/aaraj/releases/%i/api
ExecStart=/usr/bin/node /srv/sites/aaraj/releases/%i/api/scripts/migrate-production.mjs
TimeoutStartSec=1h
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/sites/aaraj
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
