# Copy to /etc/sites/aaraj/runtime.env; owner root:aaraj, mode 0640.
# API runtime credentials only. Fill values out of band; never commit secrets.
BETTER_AUTH_URL=https://__AARAJ_DOMAIN__
BETTER_AUTH_SECRET=__GENERATE_RANDOM_SECRET_AT_LEAST_32_BYTES__
BETTER_AUTH_TRUSTED_PROXIES=127.0.0.1
BETTER_AUTH_REDIS_KEY_PREFIX=aaraj:auth:
CART_REDIS_KEY_PREFIX=aaraj:cart:
THROTTLER_REDIS_KEY_PREFIX=aaraj:throttler:
CATALOG_CACHE_KEY_PREFIX=aaraj:catalog:
# Protects encrypted Order addresses, Pathao tokens, and checkout retry fingerprints.
# Keep the legacy key stable for blind address-search hashes and checkout retries.
# For rotation, replace this with ORDER_PII_KEYRING (never configure both), retain
# every old key, and re-encrypt stored Order addresses before removing old keys.
ORDER_PII_ENCRYPTION_KEY=__GENERATE_CANONICAL_BASE64URL_32_BYTE_KEY__


POSTGRES_HOST=__CERTIFICATE_VERIFIED_POSTGRES_HOSTNAME__
POSTGRES_PORT=5432
POSTGRES_DB=aaraj_production
POSTGRES_USER=aaraj_runtime
POSTGRES_PASSWORD=__AARAJ_RESTRICTED_RUNTIME_ROLE_PASSWORD__
POSTGRES_SSL_CA_FILE=/etc/sites/aaraj/postgres-ca.pem

REDIS_URL=redis://aaraj:__URL_ENCODED_AARAJ_REDIS_ACL_PASSWORD__@127.0.0.1:6379/4

R2_ACCOUNT_ID=__CLOUDFLARE_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__AARAJ_R2_ACCESS_KEY_ID__
R2_SECRET_ACCESS_KEY=__AARAJ_R2_SECRET_ACCESS_KEY__
R2_BUCKET_NAME=aaraj-media

# Optional catalogue video support. Use an account-scoped Stream API token and
# a separate random 32-byte keyring; preserve old keys until pending uploads expire.
CLOUDFLARE_STREAM_ACCOUNT_ID=__CLOUDFLARE_ACCOUNT_ID__
CLOUDFLARE_STREAM_API_TOKEN=__CLOUDFLARE_STREAM_EDIT_API_TOKEN__
CLOUDFLARE_STREAM_WEBHOOK_SECRET=__CLOUDFLARE_STREAM_WEBHOOK_SIGNING_SECRET__
CLOUDFLARE_STREAM_UPLOAD_KEYRING='{"activeKeyId":"2026-11","keys":{"2026-11":"__GENERATE_CANONICAL_BASE64URL_32_BYTE_KEY__"}}'

# Pathao values are provisioned from GitHub Environment aaraj-production.
# Pathao live merchant credentials. Leave empty to keep the integration disabled.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=

# Optional consent-based transactional SMS. Leave all empty to keep delivery off.
# Configure either Messaging Service SID or a registered Bangladesh sender ID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_STATUS_CALLBACK_URL=https://__API_HOST__/api/v1/orders/notifications/twilio/status
