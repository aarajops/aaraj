# Copy to /etc/sites/aaraj/runtime.env; owner root:aaraj, mode 0640.
# API runtime credentials only. Fill values out of band; never commit secrets.
BETTER_AUTH_URL=https://__AARAJ_DOMAIN__
BETTER_AUTH_SECRET=__GENERATE_RANDOM_SECRET_AT_LEAST_32_BYTES__
BETTER_AUTH_TRUSTED_PROXIES=127.0.0.1
BETTER_AUTH_REDIS_KEY_PREFIX=aaraj:auth:
CART_REDIS_KEY_PREFIX=aaraj:cart:
THROTTLER_REDIS_KEY_PREFIX=aaraj:throttler:
CATALOG_CACHE_KEY_PREFIX=aaraj:catalog:
# Protects Pathao tokens and checkout retry fingerprints. Keep stable across deployments.
ORDER_PII_ENCRYPTION_KEY=__GENERATE_CANONICAL_BASE64URL_32_BYTE_KEY__


POSTGRES_HOST=__CERTIFICATE_VERIFIED_POSTGRES_HOSTNAME__
POSTGRES_PORT=5432
POSTGRES_DB=aaraj_production
POSTGRES_USER=aaraj_runtime
POSTGRES_PASSWORD=__AARAJ_RESTRICTED_RUNTIME_ROLE_PASSWORD__
POSTGRES_SSL_CA_FILE=/etc/sites/aaraj/postgres-ca.pem

REDIS_URL=redis://aaraj:__URL_ENCODED_AARAJ_REDIS_ACL_PASSWORD__@127.0.0.1:6379/4

R2_ACCOUNT_ID=__CLOUDFLARE_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__AARAJ_R2_ACCESS_KEY_ID__
R2_SECRET_ACCESS_KEY=__AARAJ_R2_SECRET_ACCESS_KEY__
R2_BUCKET_NAME=aaraj-media

# Pathao values are provisioned from GitHub Environment aaraj-production.
# Pathao live merchant credentials. Leave empty to keep the integration disabled.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=
