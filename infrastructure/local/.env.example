# Local development only. Do not reuse these values outside your workstation.
POSTGRES_DB=aaraj_local
POSTGRES_USER=aaraj_local_admin
POSTGRES_PASSWORD=local-development-password
POSTGRES_PORT=5432
REDIS_PASSWORD=local-development-redis-password
REDIS_URL=redis://:local-development-redis-password@127.0.0.1:6379
REDIS_PORT=6379
BETTER_AUTH_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Protects encrypted Order addresses, Pathao tokens, and checkout retry fingerprints.
# For key rotation, use ORDER_PII_KEYRING with the current key under "legacy";
# keep that key stable for address search hashes and checkout retry fingerprints.
ORDER_PII_ENCRYPTION_KEY=
# Set ORDER_PII_KEYRING instead of ORDER_PII_ENCRYPTION_KEY when rotating keys.
# ORDER_PII_KEYRING={"activeKeyId":"legacy","keys":{"legacy":""}}

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_UPLOAD_ENCRYPTION_KEY=

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=

# Optional transactional SMS. Messages are queued only when checkout opt-in is true.
# Configure either TWILIO_MESSAGING_SERVICE_SID or TWILIO_SMS_FROM, never both.
# Bangladesh delivery on Grameenphone, Robi and Teletalk requires a registered
# alphanumeric sender ID. Two-way SMS is unavailable; customers can withdraw
# consent from their secure order page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_STATUS_CALLBACK_URL=
